@page "/panel"
@model MezunBurada.Web.Pages.Panel.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = Localizer["PanelNavDashboard"];
    ViewData["ActiveTab"] = "dashboard";
}

<h1 class="panel-welcome-title">@Localizer["WelcomeBackTitle", Model.UserName]</h1>
<p class="panel-welcome-subtitle">@Localizer["WelcomeBackSubtitle"]</p>

@if (!Model.HasTestResult)
{
    <div class="empty-state-card">
        <div class="empty-illustration">🧭</div>
        <h3>@Localizer["EmptyStateTitle"]</h3>
        <p>@Localizer["EmptyStateText"]</p>
        <a href="/test/bolum" class="btn-brand">@Localizer["StartFreeTestLabel"] &rarr;</a>
    </div>
}
else if (!Model.HasRoadmapContent)
{
    <div class="empty-state-card">
        <div class="empty-illustration">🛠️</div>
        <h3>@Localizer["NoRoadmapYetTitle"]</h3>
        <p>@Localizer["NoRoadmapYetText"]</p>
        <p class="text-muted mt-2"><strong>@Model.DepartmentName &middot; @Model.SubFieldName</strong></p>
    </div>
}
else
{
    <div class="panel-section-label">@Model.CareerPathName</div>

    <div class="panel-grid">
        <div>
            <div class="panel-card">
                <div class="roadmap-summary-header">
                    <div class="progress-ring" style="--pct: 0;">
                        <div class="progress-ring-inner">%0</div>
                    </div>
                    <div>
                        <div class="roadmap-title">@Model.CareerPathName</div>
                        <div class="roadmap-subtitle">@Localizer["RoadmapCardSubtitle"]</div>
                    </div>
                </div>

                <div class="next-step-box">
                    <div>
                        <div class="next-step-label">@Localizer["NextStepLabel"]</div>
                        <div class="next-step-title">@Model.Steps[0].Title</div>
                    </div>
                    <a href="/yol-haritasi" class="btn-brand">@Localizer["StartStepLabel"] &rarr;</a>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-card-title">@Localizer["YourRoadmapCardTitle"]</div>
                <ul class="roadmap-checklist">
                    @foreach (var step in Model.Steps)
                    {
                        var stateClass = step.State == MezunBurada.Web.Pages.Panel.IndexModel.StepState.Active ? "active" : "upcoming";
                        <li class="@stateClass">
                            <span class="check-icon"></span>
                            @step.Title
                        </li>
                    }
                </ul>
                <a href="/yol-haritasi" class="link-arrow">@Localizer["ViewFullRoadmap"] &rarr;</a>
            </div>

            <div class="stat-tile-grid">
                <div class="stat-tile">
                    <div class="stat-value">%0</div>
                    <div class="stat-label">@Localizer["StatRoadmapLabel"]</div>
                </div>
                <div class="stat-tile">
                    <div class="stat-value ltr-nums">0</div>
                    <div class="stat-label">@Localizer["StatCompletedSteps"]</div>
                </div>
                <div class="stat-tile">
                    <div class="stat-value ltr-nums">0</div>
                    <div class="stat-label">@Localizer["StatLearningHours"]</div>
                </div>
                <div class="stat-tile">
                    <div class="stat-value ltr-nums">0</div>
                    <div class="stat-label">@Localizer["StatProjects"]</div>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-card-title">@Localizer["TestResultsCardTitle"]</div>
                <ul class="kv-list">
                    <li><span class="kv-key">@Localizer["TestStepBolum"]</span><span class="kv-value">@Model.DepartmentName</span></li>
                    <li><span class="kv-key">@Localizer["TestStepIlgiAlani"]</span><span class="kv-value">@Model.SubFieldName</span></li>
                    <li><span class="kv-key">@Localizer["TestStepSeviye"]</span><span class="kv-value">@Localizer[Model.LevelResourceKey]</span></li>
                    <li><span class="kv-key">@Localizer["TestResultCareerMatch"]</span><span class="kv-value ltr-nums">%@Model.CareerMatchPercent</span></li>
                </ul>
            </div>
        </div>

        <div>
            <div class="panel-card">
                <div class="panel-card-title">@Localizer["RecentActivityCardTitle"]</div>
                <p class="text-muted">@Localizer["NoActivityYetText"]</p>
            </div>

            <div class="panel-card">
                <div class="panel-card-title">@Localizer["AchievementsCardTitle"]</div>
                <p class="text-muted">@Localizer["NoAchievementsYetText"]</p>
            </div>

            <div class="panel-card">
                <div class="panel-card-title">@Localizer["TodaySuggestionCardTitle"]</div>
                <p class="suggestion-text">@Localizer["TodaySuggestionText"]</p>
                <a href="/yol-haritasi" class="btn-brand">@Localizer["ContinueLabel"] &rarr;</a>
            </div>
        </div>
    </div>
}
