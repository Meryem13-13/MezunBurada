@page "/admin/kategoriler/duzenle/{id:int}"
@model MezunBurada.Web.Pages.Admin.Categories.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategoriyi Düzenle";
}

<h1 class="h3 mb-4">Kategoriyi Düzenle</h1>

<form method="post" class="bg-white border rounded p-4" style="max-width: 480px;">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Kategori Adı</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Slug" class="form-label">Slug</label>
        <input asp-for="Input.Slug" class="form-control" />
        <span asp-validation-for="Input.Slug" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Icon" class="form-label">İkon (opsiyonel emoji)</label>
        <input asp-for="Input.Icon" class="form-control" />
    </div>

    <button type="submit" class="btn-brand">Güncelle</button>
    <a href="/admin/kategoriler" class="btn btn-outline-secondary">Vazgeç</a>
</form>
