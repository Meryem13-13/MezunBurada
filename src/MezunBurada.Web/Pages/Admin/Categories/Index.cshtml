@page "/admin/kategoriler"
@model MezunBurada.Web.Pages.Admin.Categories.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kategoriler</h1>
    <a class="btn-brand" href="/admin/kategoriler/ekle">+ Yeni Kategori Ekle</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Categories.Any())
{
    <div class="alert alert-light border">Henüz kategori eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>İkon</th>
                <th>Kategori Adı</th>
                <th>Slug</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.Icon</td>
                    <td><strong>@cat.Name</strong></td>
                    <td class="text-muted">@cat.Slug</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/kategoriler/duzenle/@cat.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" class="d-inline"
                              onsubmit="return confirm('Bu kategoriyi silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
