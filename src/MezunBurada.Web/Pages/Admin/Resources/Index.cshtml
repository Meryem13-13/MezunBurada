@page "/admin/kaynaklar"
@model MezunBurada.Web.Pages.Admin.Resources.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kaynaklar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kaynaklar</h1>
    <a class="btn-brand" href="/admin/kaynaklar/ekle">+ Yeni Kaynak Ekle</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Resources.Any())
{
    <div class="alert alert-light border">Henüz kaynak eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Başlık</th>
                <th>URL</th>
                <th>Tip</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var resource in Model.Resources)
            {
                <tr>
                    <td><strong>@resource.Title</strong></td>
                    <td><a href="@resource.Url" target="_blank" rel="noopener">@resource.Url</a></td>
                    <td>@resource.Type</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/kaynaklar/duzenle/@resource.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@resource.Id" class="d-inline"
                              onsubmit="return confirm('Bu kaynağı silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
