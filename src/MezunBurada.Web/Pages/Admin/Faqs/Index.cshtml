@page "/admin/sss"
@model MezunBurada.Web.Pages.Admin.Faqs.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "SSS";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sık Sorulan Sorular</h1>
    <a class="btn-brand" href="/admin/sss/ekle">+ Yeni Soru Ekle</a>
</div>

@if (!Model.Faqs.Any())
{
    <div class="alert alert-light border">Henüz SSS eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Bölüm</th>
                <th>Soru</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var faq in Model.Faqs)
            {
                <tr>
                    <td>@faq.Department?.Name</td>
                    <td>@faq.Question</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/sss/duzenle/@faq.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@faq.Id" class="d-inline"
                              onsubmit="return confirm('Bu soruyu silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
