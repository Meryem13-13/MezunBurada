@page "/admin/ilgi-sorulari/ekle"
@model MezunBurada.Web.Pages.Admin.InterestQuestions.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni İlgi Alanı Sorusu";
}

<h1 class="h3 mb-4">Yeni Soru Ekle</h1>
<p class="text-muted">Kaydedince seçenek ekleyebileceğin bir sonraki sayfaya geçeceksin.</p>

<form method="post" class="bg-white border rounded p-4" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.DepartmentId" class="form-label">Bölüm</label>
        <select asp-for="Input.DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
            <option value="">-- Seç --</option>
        </select>
        <span asp-validation-for="Input.DepartmentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Text" class="form-label">Soru Metni</label>
        <input asp-for="Input.Text" class="form-control" placeholder="örn. Hangi proje seni daha çok heyecanlandırır?" />
        <span asp-validation-for="Input.Text" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-brand">Kaydet ve Seçenek Ekle</button>
    <a href="/admin/ilgi-sorulari" class="btn btn-outline-secondary">Vazgeç</a>
</form>
