@page "/admin/roadmaplar"
@model MezunBurada.Web.Pages.Admin.Roadmaps.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Roadmap'ler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Roadmap'ler</h1>
    <a class="btn-brand" href="/admin/roadmaplar/ekle">+ Yeni Roadmap Ekle</a>
</div>

@if (!Model.Roadmaps.Any())
{
    <div class="alert alert-light border">Henüz roadmap eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Kariyer Yolu</th>
                <th>Roadmap Başlığı</th>
                <th>Seviye</th>
                <th>Adım Sayısı</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var roadmap in Model.Roadmaps)
            {
                <tr>
                    <td>@roadmap.CareerPath?.Name</td>
                    <td><strong>@roadmap.Title</strong></td>
                    <td>@roadmap.Level</td>
                    <td class="ltr-nums">@roadmap.Steps.Count</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/roadmaplar/duzenle/@roadmap.Id">Düzenle / Adımlar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@roadmap.Id" class="d-inline"
                              onsubmit="return confirm('Bu roadmap\'i ve tüm adımlarını silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
