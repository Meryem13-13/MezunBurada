@page "/admin/roadmaplar/ekle"
@model MezunBurada.Web.Pages.Admin.Roadmaps.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Roadmap";
}

<h1 class="h3 mb-4">Yeni Roadmap Ekle</h1>
<p class="text-muted">Kaydedince adım ekleyebileceğin bir sonraki sayfaya geçeceksin.</p>

<form method="post" class="bg-white border rounded p-4" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.CareerPathId" class="form-label">Kariyer Yolu</label>
        <select asp-for="Input.CareerPathId" asp-items="Model.CareerPathOptions" class="form-select">
            <option value="">-- Seç --</option>
        </select>
        <span asp-validation-for="Input.CareerPathId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label">Roadmap Başlığı</label>
        <input asp-for="Input.Title" class="form-control" placeholder="örn. Backend Development — Başlangıç Yol Haritası" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Level" class="form-label">Seviye</label>
        <select asp-for="Input.Level" asp-items="Model.LevelOptions" class="form-select"></select>
    </div>

    <button type="submit" class="btn-brand">Kaydet ve Adım Ekle</button>
    <a href="/admin/roadmaplar" class="btn btn-outline-secondary">Vazgeç</a>
</form>
