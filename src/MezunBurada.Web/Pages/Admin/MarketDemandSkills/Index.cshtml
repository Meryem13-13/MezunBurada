@page "/admin/piyasa-talebi"
@model MezunBurada.Web.Pages.Admin.MarketDemandSkills.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Piyasa Talebi Becerileri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Piyasa Talebi Becerileri</h1>
    <a class="btn-brand" href="/admin/piyasa-talebi/ekle">+ Yeni Beceri Ekle</a>
</div>

<p class="text-muted">
    Bu liste, Yol Haritası sayfasındaki "🔥 Piyasada Şu An Aranan" kutusunda gösterilir
    (kariyer yoluna göre en fazla 5 tanesi listelenir).
</p>

@if (!Model.Skills.Any())
{
    <div class="alert alert-light border">Henüz beceri eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Kariyer Yolu</th>
                <th>Beceri Adı</th>
                <th>Açıklama</th>
                <th>Güncellenme Tarihi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model.Skills)
            {
                <tr>
                    <td>@skill.CareerPath?.Name</td>
                    <td><strong>@skill.SkillName</strong></td>
                    <td>@skill.DemandNote</td>
                    <td>@skill.UpdatedAt.ToString("dd.MM.yyyy")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/piyasa-talebi/duzenle/@skill.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@skill.Id" class="d-inline" onsubmit="return confirm('Bu beceriyi silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
