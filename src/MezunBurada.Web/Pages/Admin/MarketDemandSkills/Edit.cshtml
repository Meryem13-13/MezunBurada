@page "/admin/piyasa-talebi/duzenle/{id:int}"
@model MezunBurada.Web.Pages.Admin.MarketDemandSkills.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Piyasa Talebi Becerisini Düzenle";
}

<h1 class="h3 mb-4">Beceriyi Düzenle</h1>

<form method="post" class="bg-white border rounded p-4" style="max-width: 480px;">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.CareerPathId" class="form-label">Kariyer Yolu</label>
        <select asp-for="Input.CareerPathId" asp-items="Model.CareerPathOptions" class="form-select">
            <option value="">-- Seç --</option>
        </select>
        <span asp-validation-for="Input.CareerPathId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.SkillName" class="form-label">Beceri Adı</label>
        <input asp-for="Input.SkillName" class="form-control" />
        <span asp-validation-for="Input.SkillName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.DemandNote" class="form-label">Açıklama</label>
        <input asp-for="Input.DemandNote" class="form-control" />
        <span asp-validation-for="Input.DemandNote" class="text-danger"></span>
        <div class="form-text">Kaydedince güncellenme tarihi otomatik olarak bugüne ayarlanır.</div>
    </div>

    <button type="submit" class="btn-brand">Güncelle</button>
    <a href="/admin/piyasa-talebi" class="btn btn-outline-secondary">Vazgeç</a>
</form>
