@page "/admin/beceriler"
@model MezunBurada.Web.Pages.Admin.Skills.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Beceriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Beceriler</h1>
    <a class="btn-brand" href="/admin/beceriler/ekle">+ Yeni Beceri Ekle</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Skills.Any())
{
    <div class="alert alert-light border">Henüz beceri eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Beceri Adı</th>
                <th>Kategori</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model.Skills)
            {
                <tr>
                    <td><strong>@skill.Name</strong></td>
                    <td>@skill.Category</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/beceriler/duzenle/@skill.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@skill.Id" class="d-inline"
                              onsubmit="return confirm('Bu beceriyi silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
