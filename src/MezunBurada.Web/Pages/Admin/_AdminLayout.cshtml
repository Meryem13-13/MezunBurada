<!DOCTYPE html>
<html lang="tr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - MezunBurada</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/admin/bolumler">
                <span class="brand-mark">M</span>
                <span>Admin Paneli</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <a class="btn-brand-outline dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        İçerik Yönetimi
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/admin/bolumler">Bölümler</a></li>
                        <li><a class="dropdown-item" href="/admin/alt-dallar">Alt Dallar</a></li>
                        <li><a class="dropdown-item" href="/admin/kariyer-yollari">Kariyer Yolları</a></li>
                        <li><a class="dropdown-item" href="/admin/beceriler">Beceriler</a></li>
                        <li><a class="dropdown-item" href="/admin/projeler">Projeler</a></li>
                        <li><a class="dropdown-item" href="/admin/is-pozisyonlari">İş Pozisyonları</a></li>
                        <li><a class="dropdown-item" href="/admin/kaynaklar">Kaynaklar</a></li>
                        <li><a class="dropdown-item" href="/admin/sss">SSS</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="/admin/piyasa-talebi">Piyasa Talebi</a></li>
                    </ul>
                </div>
                <a class="btn-brand-outline" href="/">&larr; Siteye Dön</a>
            </div>
        </div>
    </nav>
    <div class="container pb-5">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
