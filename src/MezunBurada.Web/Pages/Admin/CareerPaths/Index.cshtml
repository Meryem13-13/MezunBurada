@page "/admin/kariyer-yollari"
@model MezunBurada.Web.Pages.Admin.CareerPaths.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kariyer Yolları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kariyer Yolları</h1>
    <a class="btn-brand" href="/admin/kariyer-yollari/ekle">+ Yeni Kariyer Yolu Ekle</a>
</div>

@if (!Model.CareerPaths.Any())
{
    <div class="alert alert-light border">Henüz kariyer yolu eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Bölüm &middot; Alt Dal</th>
                <th>Kariyer Yolu</th>
                <th>Zorluk</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cp in Model.CareerPaths)
            {
                <tr>
                    <td>@cp.SubField?.Department?.Name &middot; @cp.SubField?.Name</td>
                    <td><strong>@cp.Name</strong></td>
                    <td>@cp.Difficulty</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/kariyer-yollari/duzenle/@cp.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@cp.Id" class="d-inline"
                              onsubmit="return confirm('Bu kariyer yolunu silmek, ona bağlı roadmap/proje/iş pozisyonu gibi TÜM içeriği de siler. Emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
