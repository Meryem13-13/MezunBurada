@page "/admin/kariyer-yollari/duzenle/{id:int}"
@model MezunBurada.Web.Pages.Admin.CareerPaths.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kariyer Yolunu Düzenle";
}

<h1 class="h3 mb-4">Kariyer Yolunu Düzenle</h1>

<form method="post" class="bg-white border rounded p-4" style="max-width: 560px;">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.SubFieldId" class="form-label">Alt Dal</label>
        <select asp-for="Input.SubFieldId" asp-items="Model.SubFieldOptions" class="form-select">
            <option value="">-- Seç --</option>
        </select>
        <span asp-validation-for="Input.SubFieldId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Kariyer Yolu Adı</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">Açıklama</label>
        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Difficulty" class="form-label">Zorluk</label>
        <input asp-for="Input.Difficulty" class="form-control" />
    </div>

    <button type="submit" class="btn-brand">Güncelle</button>
    <a href="/admin/kariyer-yollari" class="btn btn-outline-secondary">Vazgeç</a>
</form>

<div class="bg-white border rounded p-4 mt-4" style="max-width: 560px;">
    <h2 class="h5 mb-3">Gerekli Beceriler</h2>

    @if (!Model.CareerPathSkills.Any())
    {
        <p class="text-muted">Bu kariyer yoluna henüz beceri eklenmemiş.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var cps in Model.CareerPathSkills)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @cps.Skill?.Name <span class="text-muted small">(@cps.RequiredLevel)</span>
                    <form method="post" asp-page-handler="RemoveSkill" asp-route-id="@Model.Input.Id" asp-route-skillId="@cps.SkillId" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Kaldır</button>
                    </form>
                </li>
            }
        </ul>
    }

    <form method="post" asp-page-handler="AddSkill" asp-route-id="@Model.Input.Id" class="d-flex gap-2">
        <select asp-for="NewSkill.SkillId" asp-items="Model.SkillOptions" class="form-select">
            <option value="">-- Beceri Seç --</option>
        </select>
        <select asp-for="NewSkill.RequiredLevel" asp-items="Model.LevelOptions" class="form-select"></select>
        <button type="submit" class="btn-brand text-nowrap">Ekle</button>
    </form>
</div>
