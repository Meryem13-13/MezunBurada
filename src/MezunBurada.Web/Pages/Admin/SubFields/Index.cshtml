@page "/admin/alt-dallar"
@model MezunBurada.Web.Pages.Admin.SubFields.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Alt Dallar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Alt Dallar (Kariyer Alanları)</h1>
    <a class="btn-brand" href="/admin/alt-dallar/ekle">+ Yeni Alt Dal Ekle</a>
</div>

@if (!Model.SubFields.Any())
{
    <div class="alert alert-light border">Henüz alt dal eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Bölüm</th>
                <th>Alt Dal</th>
                <th>Zorluk</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sf in Model.SubFields)
            {
                <tr>
                    <td>@sf.Department?.Name</td>
                    <td><strong>@sf.Name</strong><br /><span class="text-muted small">@sf.Slug</span></td>
                    <td>@sf.DifficultyLevel</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/alt-dallar/duzenle/@sf.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@sf.Id" class="d-inline"
                              onsubmit="return confirm('Bu alt dalı silmek, ona bağlı kariyer yolu/soru/roadmap gibi TÜM içeriği de siler. Emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
