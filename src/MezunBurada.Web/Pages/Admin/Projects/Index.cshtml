@page "/admin/projeler"
@model MezunBurada.Web.Pages.Admin.Projects.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Projeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Projeler</h1>
    <a class="btn-brand" href="/admin/projeler/ekle">+ Yeni Proje Ekle</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.Projects.Any())
{
    <div class="alert alert-light border">Henüz proje eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Kariyer Yolu</th>
                <th>Proje Adı</th>
                <th>Zorluk</th>
                <th>Süre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model.Projects)
            {
                <tr>
                    <td>@project.CareerPath?.Name</td>
                    <td><strong>@project.Name</strong></td>
                    <td>@project.Difficulty</td>
                    <td>@project.EstimatedDuration</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/projeler/duzenle/@project.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@project.Id" class="d-inline"
                              onsubmit="return confirm('Bu projeyi silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
