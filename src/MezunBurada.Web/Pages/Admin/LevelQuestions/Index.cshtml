@page "/admin/seviye-sorulari"
@model MezunBurada.Web.Pages.Admin.LevelQuestions.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Seviye Testi Soruları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Seviye Testi Soruları</h1>
    <a class="btn-brand" href="/admin/seviye-sorulari/ekle">+ Yeni Soru Ekle</a>
</div>

<p class="text-muted">Bu sorular alt dala özeldir — doğru cevap işaretli seçenekler kullanıcının seviyesini (Başlangıç/Orta/İleri) hesaplar.</p>

@if (!Model.Questions.Any())
{
    <div class="alert alert-light border">Henüz soru eklenmemiş.</div>
}
else
{
    <table class="table table-bordered align-middle bg-white">
        <thead>
            <tr>
                <th>Bölüm &middot; Alt Dal</th>
                <th>Soru</th>
                <th>Zorluk</th>
                <th>Puan</th>
                <th>Seçenek</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Questions)
            {
                <tr>
                    <td>@q.SubField?.Department?.Name &middot; @q.SubField?.Name</td>
                    <td>@q.Text</td>
                    <td>@q.Difficulty</td>
                    <td class="ltr-nums">@q.Points</td>
                    <td class="ltr-nums">@q.Options.Count</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/seviye-sorulari/duzenle/@q.Id">Düzenle / Seçenekler</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@q.Id" class="d-inline"
                              onsubmit="return confirm('Bu soruyu ve tüm seçeneklerini silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
