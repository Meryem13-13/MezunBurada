@page "/kayit"
@model MezunBurada.Web.Pages.Account.KayitModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["RegisterHeadline"];
    ViewData["AuthHeadlineKey"] = "RegisterHeadline";
}

<div class="auth-form-card">
    <h2>@Localizer["RegisterHeadline"]</h2>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @if (Model.ErrorMessage is not null)
        {
            <div class="text-danger mb-3">@Model.ErrorMessage</div>
        }

        <div class="form-field">
            <label asp-for="Input.FullName">@Localizer["FullNameLabel"]</label>
            <input asp-for="Input.FullName" placeholder="@Localizer["FullNameLabel"]" />
        </div>
        <div class="form-field">
            <label asp-for="Input.Email">@Localizer["EmailLabel"]</label>
            <input asp-for="Input.Email" type="email" placeholder="@Localizer["EmailPlaceholder"]" />
        </div>
        <div class="form-field">
            <label asp-for="Input.Password">@Localizer["PasswordLabel"]</label>
            <input asp-for="Input.Password" type="password" />
            <div class="form-hint">@Localizer["PasswordMinHint"]</div>
        </div>
        <label class="form-check-row">
            <input asp-for="Input.AcceptTerms" />
            <span>@Html.Raw(Localizer["TermsAgreementText"].Value)</span>
        </label>

        <button type="submit" class="btn-brand full-width">@Localizer["RegisterButtonLabel"] &rarr;</button>

        <div class="auth-divider">@Localizer["OrDividerLabel"]</div>

        <a href="#" class="btn-google"><span class="g-icon"></span> @Localizer["GoogleContinueLabel"]</a>

        <p class="auth-switch-text">
            @Localizer["HaveAccountLabel"] <a href="/giris">@Localizer["LoginButtonLabel"]</a>
        </p>
        <p class="auth-trust-text">@Localizer["TrustText"]</p>
    </form>
</div>
