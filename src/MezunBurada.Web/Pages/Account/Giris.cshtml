@page "/giris"
@model MezunBurada.Web.Pages.Account.GirisModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["LoginFormTitle"];
    ViewData["AuthHeadlineKey"] = "LoginIllustrationHeadline";
}

<div class="auth-form-card">
    <h2>@Localizer["LoginFormTitle"]</h2>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @if (Model.ErrorMessage is not null)
        {
            <div class="text-danger mb-3">@Model.ErrorMessage</div>
        }

        <div class="form-field">
            <label asp-for="Input.Email">@Localizer["EmailLabel"]</label>
            <input asp-for="Input.Email" type="email" placeholder="@Localizer["EmailPlaceholder"]" />
        </div>
        <div class="form-field">
            <label asp-for="Input.Password">@Localizer["PasswordLabel"]</label>
            <input asp-for="Input.Password" type="password" />
        </div>
        <a href="/sifremi-unuttum" class="form-forgot-link">@Localizer["ForgotPasswordLabel"]</a>

        <button type="submit" class="btn-brand full-width">@Localizer["LoginButtonLabel"] &rarr;</button>

        <div class="auth-divider">@Localizer["OrDividerLabel"]</div>

        <a href="#" class="btn-google"><span class="g-icon"></span> @Localizer["GoogleContinueLabel"]</a>

        <p class="auth-switch-text">
            @Localizer["NoAccountLabel"] <a href="/kayit">@Localizer["SignUpLinkLabel"]</a>
        </p>
    </form>
</div>
