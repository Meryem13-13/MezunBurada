@page "/test/bolum"
@model MezunBurada.Web.Pages.Test.BolumModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "_TestLayout";
    ViewData["Title"] = Localizer["BolumSecimiQuestion"];
    ViewData["TestTitle"] = Localizer["CareerTestTitle"];
}

<div class="numbered-stepper">
    <span class="step active">1. @Localizer["TestStepBolum"]</span>
    <span class="step">2. @Localizer["TestStepIlgiAlani"]</span>
    <span class="step">3. @Localizer["TestStepSeviye"]</span>
    <span class="step">4. @Localizer["StepSonuc"]</span>
</div>
<div class="numbered-stepper-track">
    <div class="fill" style="width: 25%;"></div>
</div>

<h1 class="accent-heading">@Localizer["BolumSecimiQuestion"]</h1>

<input type="text" class="search-input" placeholder="@Localizer["SearchDepartmentPlaceholder"]" />

<div class="dept-grid">
    @foreach (var dept in Model.Departments)
    {
        <a href="/test/ilgi-alani?departmentId=@dept.Id" class="dept-card">@dept.Name</a>
    }
</div>

<p class="dept-not-found-text">
    @Localizer["DeptNotFoundText"] <a href="#">@Localizer["ContactUsLink"] &rarr;</a>
</p>
