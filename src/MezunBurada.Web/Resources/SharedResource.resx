  <data name="TermsServiceDescriptionTitle" xml:space="preserve">
    <value>Hizmetin Kapsamı</value>
  </data>
  <data name="TermsServiceDescriptionText" xml:space="preserve">
    <value>MezunBurada, yeni mezunlara ücretsiz kariyer testi ve kişiselleştirilmiş yol haritası sunan bir platformdur. Sunulan öneriler genel rehberlik niteliğindedir, profesyonel kariyer danışmanlığının yerini almaz.</value>
